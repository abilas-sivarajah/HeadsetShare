<Project Sdk="WixToolset.Sdk/5.0.2">

  <PropertyGroup>
    <OutputName>HeadsetShare</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <ProductVersion Condition="'$(ProductVersion)' == ''">0.1.0</ProductVersion>
    <PublishedApp Condition="'$(PublishedApp)' == ''">..\publish\app\HeadsetShare.exe</PublishedApp>
    <DefineConstants>ProductVersion=$(ProductVersion);PublishedApp=$(PublishedApp)</DefineConstants>
  </PropertyGroup>

</Project>
